rules_version = '2';

// ===============================================================
// Mô hình vai trò (users/{uid}.role)
//   user   : mặc định khi đăng nhập lần đầu, CHỜ DUYỆT, chỉ xem
//   editor : đã được admin duyệt, thêm/sửa members, events
//   admin  : tất cả + duyệt/khóa người dùng, xóa dữ liệu
// Super admin: email cố định dưới đây, luôn có quyền admin.
// LƯU Ý: email này cũng khai báo ở src/config.ts và biến môi trường
// SUPER_ADMIN_EMAIL trên Cloudflare Pages. Đổi thì đổi cả 3 nơi.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Helpers ----------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == "hanhtoami@gmail.com" &&
             request.auth.token.email_verified == true;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isAuthenticated() && userDocExists() && userDoc().isLocked != true;
    }

    function isAdmin() {
      return isSuperAdmin() || (isActive() && userDoc().role == 'admin');
    }

    function isEditor() {
      return isSuperAdmin() || (isActive() && userDoc().role in ['editor', 'admin']);
    }

    // Dạng Date.toISOString(): 2026-10-17T01:00:00.000Z
    function isValidDateString(dateStr) {
      return dateStr is string &&
        dateStr.matches("^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$");
    }

    // Trường không bắt buộc: thiếu, hoặc là chuỗi tối đa max ký tự
    function optString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // Như optString nhưng cho phép null (tài khoản Google có thể không có tên/ảnh)
    function optStringOrNull(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    // Mã document (fatherId, motherId, memberId)
    function optDocId(data, key) {
      return !(key in data) || (data[key] is string && data[key].matches("^[A-Za-z0-9_-]{1,64}$"));
    }

    // ---------------- Validators ----------------

    function isValidMember(data) {
      return data.keys().hasOnly(["name", "gender", "generation", "birthDate", "deathDate", "branch", "role",
                                  "biography", "fatherId", "motherId", "spouse", "address", "photoUrl", "status"]) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.gender in ["Nam", "Nữ"] &&
             data.generation is int && data.generation >= 1 && data.generation <= 100 &&
             (!("status" in data) || data.status in ["Alive", "Deceased"]) &&
             optDocId(data, "fatherId") && optDocId(data, "motherId") &&
             optString(data, "birthDate", 100) && optString(data, "deathDate", 100) &&
             optString(data, "branch", 200) && optString(data, "role", 200) &&
             optString(data, "spouse", 500) && optString(data, "address", 500) &&
             optString(data, "biography", 20000) && optString(data, "photoUrl", 2000);
    }

    function isValidLunar(l) {
      return l is map && l.keys().hasOnly(["day", "month", "year", "leap"]) &&
             l.day is int && l.day >= 1 && l.day <= 30 &&
             l.month is int && l.month >= 1 && l.month <= 12 &&
             l.year is int && l.year >= 1 && l.year <= 9999 &&
             (!("leap" in l) || l.leap is bool);
    }

    function isValidEvent(data) {
      return data.keys().hasOnly(["title", "date", "calendar", "lunar", "recurring", "location",
                                  "description", "type", "memberId"]) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             isValidDateString(data.date) &&
             data.type in ["Kỵ nhật", "Hội họp", "Khác"] &&
             (!("calendar" in data) || data.calendar in ["lunar", "solar"]) &&
             (!("lunar" in data) || isValidLunar(data.lunar)) &&
             (!("recurring" in data) || data.recurring is bool) &&
             optString(data, "location", 500) && optString(data, "description", 5000) &&
             optDocId(data, "memberId");
    }

    function isValidPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.kind in ["article", "link"] &&
             data.published is bool &&
             (!("content" in data) || (data.content is string && data.content.size() < 200000)) &&
             (!("summary" in data) || (data.summary is string && data.summary.size() <= 1000)) &&
             (!("sources" in data) || (data.sources is list && data.sources.size() <= 30)) &&
             isValidDateString(data.createdAt) && isValidDateString(data.updatedAt);
    }

    // Tên người ghi phải là tên hoặc email của chính tài khoản đang đăng nhập (không mạo danh được)
    function isValidActivity(data) {
      return data.keys().hasOnly(["userName", "userPhoto", "action", "timestamp"]) &&
             data.userName is string && data.userName.size() > 0 &&
             (data.userName == request.auth.token.get("name", null) ||
              data.userName == request.auth.token.get("email", null)) &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 500 &&
             optStringOrNull(data, "userPhoto", 2000) &&
             isValidDateString(data.timestamp);
    }

    // Hồ sơ người dùng: email phải là email đăng nhập thật; tên/ảnh lấy từ Google, có giới hạn độ dài
    function isValidProfile(data) {
      return data.keys().hasOnly(["email", "displayName", "photoURL", "role", "isLocked", "createdAt", "lastLogin"]) &&
             (!("email" in data) || data.email == request.auth.token.get("email", null)) &&
             optStringOrNull(data, "displayName", 100) &&
             optStringOrNull(data, "photoURL", 2000) &&
             (!("createdAt" in data) || data.createdAt is timestamp) &&
             (!("lastLogin" in data) || data.lastLogin is timestamp);
    }

    // ---------------- members ----------------
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if isEditor() && isValidMember(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------------- events ----------------
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isEditor() && isValidEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------------- activities (nhật ký, bất biến) ----------------
    match /activities/{activityId} {
      allow read: if true;
      allow create: if isEditor() && isValidActivity(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------- posts (trang Thông tin: bài viết và bài báo nhúng) ----------------
    // Ai cũng đọc bài đã xuất bản; truy vấn công khai phải lọc published == true.
    // Chỉ quản trị viên thêm, sửa, xóa và xem bản nháp.
    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidPost(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------------- settings (cấu hình site, ví dụ nhạc nền trang Giới thiệu) ----------------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- users ----------------
    match /users/{userId} {
      // Chính chủ đọc hồ sơ mình; admin đọc/list tất cả để duyệt.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Tự tạo hồ sơ lần đầu: bắt buộc role 'user' (chờ duyệt) và không khóa.
      // Super admin được tạo với role 'admin'.
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                    isValidProfile(request.resource.data) &&
                    request.resource.data.isLocked == false &&
                    (
                      request.resource.data.role == 'user' ||
                      (isSuperAdmin() && request.resource.data.role == 'admin')
                    );

      // Chính chủ chỉ được cập nhật thông tin hiển thị, KHÔNG được đụng role/isLocked.
      // Email chỉ được đổi thành email đăng nhập thật.
      allow update: if isAuthenticated() && request.auth.uid == userId &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['displayName', 'photoURL', 'lastLogin', 'email']) &&
                    (!('email' in request.resource.data.diff(resource.data).affectedKeys()) ||
                     request.resource.data.email == request.auth.token.get("email", null)) &&
                    optStringOrNull(request.resource.data, "displayName", 100) &&
                    optStringOrNull(request.resource.data, "photoURL", 2000) &&
                    (!("lastLogin" in request.resource.data) || request.resource.data.lastLogin is timestamp);

      // Admin duyệt (user -> editor), thu hồi, khóa/mở khóa.
      // Chỉ super admin mới được gán hoặc gỡ role 'admin'.
      allow update: if isAdmin() && request.auth.uid != userId &&
                    request.resource.data.role in ['user', 'editor', 'admin'] &&
                    (
                      isSuperAdmin() ||
                      (request.resource.data.role != 'admin' && resource.data.role != 'admin')
                    );

      // Xóa hồ sơ = gỡ mọi quyền, nên chỉ super admin (admin thường xóa được admin khác là vượt quyền)
      allow delete: if isSuperAdmin();
    }
  }
}
